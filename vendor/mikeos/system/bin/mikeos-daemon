#!/system/bin/sh
# =============================================================================
# mikeos-daemon — MikeOS daemon launcher (daemon-as-system).
#
# Installed to /product/bin/mikeos-daemon, run by the init service `mikeos-daemon`
# (vendor/mikeos/system/init/mikedaemon.rc) under ROOT. Launches the baked,
# Termux-FREE runtime (Node + Redis + the mikedaemon dist/) shipped at
# /product/mikeos/mikeos-runtime.tar.gz and extracted once to /data/mikeos/runtime.
#
# DATASTORE = SQLite (node:sqlite), NOT Postgres.
#   The Pixel 9a (tegu) GKI kernel has SysV IPC compiled out (CONFIG_SYSVIPC is
#   not set) — no shared memory, no semaphores, no /dev/shm — so PostgreSQL's
#   postmaster CPU-spins forever at startup and can never run. SQLite is
#   in-process (one file, zero kernel IPC) so it works on every Android kernel.
#   The daemon's DB layer was migrated pg -> node:sqlite (src/services/pg-compat.ts);
#   validated on tegu: schema applies, /api/health = ok, 7743 + 7742 serve.
#   => NO postgres, NO `su` (we no longer drop to a datastore uid), NO initdb.
#
# Everything uses ABSOLUTE, writable /data/mikeos paths (cwd-independent).
# dist/index.js is UNTOUCHED except the DB layer — line 2 stays require('./dns-fix.js').
# =============================================================================

set -u

MIKEOS_RUNTIME="${MIKEOS_RUNTIME:-/data/mikeos/runtime}"
MIKEOS_PAYLOAD="${MIKEOS_PAYLOAD:-/product/mikeos/mikeos-runtime.tar.gz}"
MIKEOS_PREFIX="${MIKEOS_PREFIX:-$MIKEOS_RUNTIME}"
MIKEOS_DAEMON_DIR="${MIKEOS_DAEMON_DIR:-$MIKEOS_RUNTIME/daemon}"

MIKEOS_DATA=/data/mikeos
REDISDIR="$MIKEOS_DATA/redis"

# ---------------------------------------------------------------------------
# Environment — absolute, writable, Termux-FREE.
# ---------------------------------------------------------------------------
export HOME="$MIKEOS_DATA/daemon"
export TMPDIR="$MIKEOS_DATA/run"
export PREFIX="$MIKEOS_PREFIX"
export PATH="$MIKEOS_PREFIX/bin:/system/bin:/vendor/bin"
export LD_LIBRARY_PATH="$MIKEOS_PREFIX/lib:/system/lib64:/vendor/lib64"
export LANG=en_US.UTF-8
# SQLite datastore (one file). node:sqlite in the baked Node 26 opens it; the
# daemon's pg-compat adapter reads SQLITE_DB_PATH.
export SQLITE_DB_PATH="$MIKEOS_DATA/db/mikeos.db"
# Legacy var some code still reads; harmless sqlite: URL (adapter ignores it).
export DATABASE_URL="sqlite://$SQLITE_DB_PATH"
export REDIS_URL="redis://127.0.0.1:6379"
# IPC unix socket — MUST be a writable path. /run does not exist on Android
# (read-only rootfs), which fatally crashed the daemon (mkdir /run/miked ENOENT).
export IPC_SOCKET_PATH="$MIKEOS_DATA/run/miked.sock"
export OLLAMA_GPU_URL="ollama://mikeos:uB49VXwMDy7R2JE0H7mI@81.8.177.182:11443"
export NODE_OPTIONS=--max-old-space-size=1024
# THE daemon auth token every MikeOS app uses. WITHOUT this the daemon can't persist a
# token to the read-only /etc/mikeos, so it mints a RANDOM in-memory token each boot and
# rejects every app's bearer (401 on /api/agent/chat, /api/devices/pair, etc.) — which broke
# onboarding pairing ("can't reach the MikeOS brain"). auth.ts reads MIKEOS_DAEMON_TOKEN first.
export MIKEOS_DAEMON_TOKEN=7bdc23451b18b5801036f992b66a872670975d19

log() { echo "[mikeos-daemon] $*"; }

# ---------------------------------------------------------------------------
# NAVIGATION: force 3-button nav (backup enforcement — the baked framework
# overlay config_navBarInteractionMode=0 is primary; QuickStep is back since v13
# because Android 16 renders ALL nav via the Launcher taskbar). Idempotent.
# ---------------------------------------------------------------------------
(
  n=0
  until [ $n -ge 30 ]; do
    if cmd overlay enable-exclusive --category com.android.internal.systemui.navbar.threebutton >/dev/null 2>&1; then
      settings put secure navigation_mode 0 >/dev/null 2>&1 || true
      log "navigation: 3-button enforced"
      break
    fi
    n=$((n+1)); sleep 5
  done
) &

# ---------------------------------------------------------------------------
# ASSISTED GPS (positioning.md Phase 1) — the GNSS HAL logged "PSDS disabled by
# system setting", so the phone decodes ephemeris from the sky (slow cold TTFF
# 2-5 min, fails in urban canyons). assisted_gps_enabled=1 lets the HAL pull
# predicted satellite data (PSDS) + SUPL over the network. Root, reversible,
# idempotent. (SUPL host itself is in the vendor blob; this is the free lever.)
# ---------------------------------------------------------------------------
(
  n=0
  until [ $n -ge 30 ]; do
    if [ "$(getprop sys.boot_completed)" = "1" ]; then
      settings put global assisted_gps_enabled 1 >/dev/null 2>&1 || true
      log "assisted GPS (PSDS/SUPL) enabled"
      break
    fi
    n=$((n+1)); sleep 5
  done
) &

# ---------------------------------------------------------------------------
# HOME ROLE ENFORCE — kill the "MikeOS Home vs Trebuchet" chooser for good.
# With QuickStep restored (it renders ALL navigation on Android 16) there are two
# HOME candidates; the config_defaultHome overlay did not reliably win the role
# on first boot, so users got a launcher chooser after onboarding. Root may set
# the role directly. BENCH-VERIFIED (CF instance, same two-launcher setup):
# add-role-holder -> repeated HOME goes straight to MikeOS Home, no chooser, and
# QuickStep still draws the navbar + working Recents while NOT being the holder.
# Idempotent; retried until role service is up.
# ---------------------------------------------------------------------------
(
  # NO retry cap: on a slow first boot (dexopt) + a fast user, the capped loop
  # expired before the role service accepted the grant -> chooser at wizard exit
  # (2026-07-27 v17 incident). Loop until BOTH mechanisms confirm; exits on success.
  until false; do
    if [ "$(getprop sys.boot_completed)" = "1" ]; then
      cmd role add-role-holder --user 0 android.app.role.HOME com.mikeos.launcher >/dev/null 2>&1 || true
      # second, independent mechanism — the persistent preferred activity
      # (identical to the user tapping "Always"); bench-verified.
      cmd package set-home-activity --user 0 com.mikeos.launcher/.MainActivity >/dev/null 2>&1 || true
      HOLDER=$(cmd role get-role-holders --user 0 android.app.role.HOME 2>/dev/null)
      case "$HOLDER" in *com.mikeos.launcher*) log "home role: com.mikeos.launcher enforced (role + preferred)"; break;; esac
    fi
    sleep 5
  done
) &

# ---------------------------------------------------------------------------
# LOCATION PROVIDER KICK — the fix for "GPS dead on a fresh phone".
# A freshly-installed (= freshly-wiped) app sits in Android's STOPPED STATE and
# does NOT receive BOOT_COMPLETED until something launches a component — so the
# baked com.mikeos.location provider NEVER started on a factory-fresh boot
# (daemon saw pushReceived=0 forever; the whole GPS chain looked dead).
# We run as root init, and root MAY send the protected BOOT_COMPLETED broadcast
# explicitly with --include-stopped-packages (verified live on tegu 2026-07-27):
# it clears the stopped state, fires the app's BootReceiver, and the provider
# FGS comes up. Retried until the provider process exists; re-run every boot
# (idempotent — a running provider just gets a duplicate receiver call).
# ---------------------------------------------------------------------------
(
  n=0
  until [ $n -ge 40 ]; do
    if [ "$(getprop sys.boot_completed)" = "1" ]; then
      am broadcast --include-stopped-packages \
        -n com.mikeos.location/.BootReceiver \
        -a android.intent.action.BOOT_COMPLETED >/dev/null 2>&1 || true
      sleep 4
      if pidof com.mikeos.location >/dev/null 2>&1; then
        log "location provider: com.mikeos.location kicked and running"
        break
      fi
    fi
    n=$((n+1)); sleep 5
  done
  pidof com.mikeos.location >/dev/null 2>&1 || log "location provider: NOT running after kick retries"
) &

# ---------------------------------------------------------------------------
# BAKED "mikeos" WI-FI — hard-coded network credentials for every MikeOS phone.
# Product decision: if a Wi-Fi called "mikeos" is in range, the phone joins it
# with passphrase "mikeos123" WITHOUT the user ever typing it. We do NOT force
# Wi-Fi on or force a connect; we just PRE-SAVE the credentials as a known
# network, so Android's normal auto-join picks it whenever it appears.
#
# Mechanism: `cmd wifi add-network <ssid> wpa2 <passphrase>` (WifiShellCommand),
# callable by the root/shell uid — we are root init. wpa2 == WPA2-PSK, the
# common home-AP case. Saved networks are enabled + auto-joinable by default.
# Idempotent: we only add it once (skip if `list-networks` already shows it),
# so re-adds don't pile up duplicate configs across reboots. Retried until the
# Wi-Fi service is up. Reversible (user can Forget it in Settings).
# ---------------------------------------------------------------------------
(
  n=0
  until [ $n -ge 40 ]; do
    if [ "$(getprop sys.boot_completed)" = "1" ]; then
      # already saved? (list-networks prints "<id>  mikeos  [WPA2...]")
      if cmd wifi list-networks 2>/dev/null | grep -qiE '(^|[[:space:]])mikeos([[:space:]]|$)'; then
        log "wifi: 'mikeos' network already saved"
        break
      fi
      if cmd wifi add-network mikeos wpa2 mikeos123 >/dev/null 2>&1; then
        log "wifi: baked 'mikeos' network saved (WPA2, auto-join)"
        break
      fi
    fi
    n=$((n+1)); sleep 5
  done
) &

# ---------------------------------------------------------------------------
# 0. VERSION-AWARE EXTRACTION of the baked runtime payload.
# Mike's rule: code lives in the SYSTEM PAYLOAD (this tarball), never hand-
# pushed into data dirs. The old ".extracted"-marker check meant a ROM update
# NEVER refreshed the extracted daemon (version skew by design). Now the
# payload carries a RUNTIME_VERSION file; any mismatch with the extracted copy
# triggers a clean re-extract, so ROM update => daemon update, atomically.
# State (/data/mikeos/{db,daemon,redis,run}) is untouched by re-extraction.
# ---------------------------------------------------------------------------
PAYLOAD_VER=$(tar -xzOf "$MIKEOS_PAYLOAD" RUNTIME_VERSION 2>/dev/null | head -1)
CURRENT_VER=$(cat "$MIKEOS_RUNTIME/RUNTIME_VERSION" 2>/dev/null | head -1)
if [ ! -x "$MIKEOS_RUNTIME/bin/node" ] || [ -z "$CURRENT_VER" ] || \
   { [ -n "$PAYLOAD_VER" ] && [ "$PAYLOAD_VER" != "$CURRENT_VER" ]; }; then
    if [ -f "$MIKEOS_PAYLOAD" ]; then
        log "runtime extract: payload='$PAYLOAD_VER' extracted='$CURRENT_VER' -> (re)extracting"
        rm -rf "$MIKEOS_RUNTIME"
        mkdir -p "$MIKEOS_RUNTIME"
        if tar -xzf "$MIKEOS_PAYLOAD" -C "$MIKEOS_RUNTIME" 2>/dev/null; then
            chmod -R a+rX "$MIKEOS_RUNTIME" 2>/dev/null || true
            touch "$MIKEOS_RUNTIME/.extracted"
            log "runtime extracted OK (version: ${PAYLOAD_VER:-unstamped})"
        else
            log "FATAL: runtime extraction failed"; exit 1
        fi
    else
        log "FATAL: baked runtime payload not found at $MIKEOS_PAYLOAD"; exit 1
    fi
else
    log "runtime up-to-date (version: $CURRENT_VER)"
fi
export MIKEOS_RUNTIME_VERSION="${PAYLOAD_VER:-$CURRENT_VER}"

# ---------------------------------------------------------------------------
# 1. Termux-shell shim. The baked Node is a Termux build; its child_process
#    default shell is /data/data/com.termux/files/usr/bin/sh (absent here).
# ---------------------------------------------------------------------------
mkdir -p /data/data/com.termux/files/usr/bin 2>/dev/null || true
ln -sf /system/bin/sh /data/data/com.termux/files/usr/bin/sh 2>/dev/null || true

# ---------------------------------------------------------------------------
# 2. Data dirs (absolute + writable). SQLite db dir + daemon HOME + tmp + redis.
# ---------------------------------------------------------------------------
mkdir -p "$MIKEOS_DATA/db" "$REDISDIR" "$HOME" "$TMPDIR" 2>/dev/null || true
chmod 0771 "$MIKEOS_DATA" 2>/dev/null || true

# ---------------------------------------------------------------------------
# 3. Redis — ephemeral cache/bus (durable data is in SQLite). Absolute dir,
#    never block writes on a bgsave failure. Runs as the (root) service user.
# ---------------------------------------------------------------------------
redis-cli -p 6379 ping >/dev/null 2>&1 || \
  redis-server --daemonize yes --port 6379 \
    --dir "$REDISDIR" \
    --stop-writes-on-bgsave-error no >/dev/null 2>&1 || \
    log "WARN: redis start returned non-zero (continuing)"

sleep 1

# ---------------------------------------------------------------------------
# 4. exec the daemon in the FOREGROUND so init supervises node directly and
#    restarts it on crash.
# ---------------------------------------------------------------------------
cd "$MIKEOS_DAEMON_DIR" 2>/dev/null || { log "FATAL: daemon dir $MIKEOS_DAEMON_DIR not found"; exit 1; }
log "starting node dist/index.js (SQLITE_DB_PATH=$SQLITE_DB_PATH IPC=$IPC_SOCKET_PATH)"
exec node "$MIKEOS_DAEMON_DIR/dist/index.js"
