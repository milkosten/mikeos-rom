#!/system/bin/sh
# =============================================================================
# mikeos-daemon — MikeOS daemon launcher (daemon-as-system).
#
# Installed to /product/bin/mikeos-daemon, run by the init service `mikeos-daemon`
# (vendor/mikeos/system/init/mikedaemon.rc) under ROOT. Launches the baked,
# Termux-FREE runtime (Node + Redis + the mikedaemon dist/) shipped at
# /product/mikeos/mikeos-runtime.tar.gz and extracted once to /data/mikeos/runtime.
#
# DATASTORE = SQLite (node:sqlite), NOT Postgres.
#   The Pixel 9a (tegu) GKI kernel has SysV IPC compiled out (CONFIG_SYSVIPC is
#   not set) — no shared memory, no semaphores, no /dev/shm — so PostgreSQL's
#   postmaster CPU-spins forever at startup and can never run. SQLite is
#   in-process (one file, zero kernel IPC) so it works on every Android kernel.
#   The daemon's DB layer was migrated pg -> node:sqlite (src/services/pg-compat.ts);
#   validated on tegu: schema applies, /api/health = ok, 7743 + 7742 serve.
#   => NO postgres, NO `su` (we no longer drop to a datastore uid), NO initdb.
#
# Everything uses ABSOLUTE, writable /data/mikeos paths (cwd-independent).
# dist/index.js is UNTOUCHED except the DB layer — line 2 stays require('./dns-fix.js').
# =============================================================================

set -u

MIKEOS_RUNTIME="${MIKEOS_RUNTIME:-/data/mikeos/runtime}"
MIKEOS_PAYLOAD="${MIKEOS_PAYLOAD:-/product/mikeos/mikeos-runtime.tar.gz}"
MIKEOS_PREFIX="${MIKEOS_PREFIX:-$MIKEOS_RUNTIME}"
MIKEOS_DAEMON_DIR="${MIKEOS_DAEMON_DIR:-$MIKEOS_RUNTIME/daemon}"

MIKEOS_DATA=/data/mikeos
REDISDIR="$MIKEOS_DATA/redis"

# ---------------------------------------------------------------------------
# Environment — absolute, writable, Termux-FREE.
# ---------------------------------------------------------------------------
export HOME="$MIKEOS_DATA/daemon"
export TMPDIR="$MIKEOS_DATA/run"
export PREFIX="$MIKEOS_PREFIX"
export PATH="$MIKEOS_PREFIX/bin:/system/bin:/vendor/bin"
export LD_LIBRARY_PATH="$MIKEOS_PREFIX/lib:/system/lib64:/vendor/lib64"
export LANG=en_US.UTF-8
# SQLite datastore (one file). node:sqlite in the baked Node 26 opens it; the
# daemon's pg-compat adapter reads SQLITE_DB_PATH.
export SQLITE_DB_PATH="$MIKEOS_DATA/db/mikeos.db"
# Legacy var some code still reads; harmless sqlite: URL (adapter ignores it).
export DATABASE_URL="sqlite://$SQLITE_DB_PATH"
export REDIS_URL="redis://127.0.0.1:6379"
# IPC unix socket — MUST be a writable path. /run does not exist on Android
# (read-only rootfs), which fatally crashed the daemon (mkdir /run/miked ENOENT).
export IPC_SOCKET_PATH="$MIKEOS_DATA/run/miked.sock"
export OLLAMA_GPU_URL="ollama://mikeos:uB49VXwMDy7R2JE0H7mI@81.8.177.182:11443"
export NODE_OPTIONS=--max-old-space-size=1024
# THE daemon auth token every MikeOS app uses. WITHOUT this the daemon can't persist a
# token to the read-only /etc/mikeos, so it mints a RANDOM in-memory token each boot and
# rejects every app's bearer (401 on /api/agent/chat, /api/devices/pair, etc.) — which broke
# onboarding pairing ("can't reach the MikeOS brain"). auth.ts reads MIKEOS_DAEMON_TOKEN first.
export MIKEOS_DAEMON_TOKEN=7bdc23451b18b5801036f992b66a872670975d19

log() { echo "[mikeos-daemon] $*"; }

# ---------------------------------------------------------------------------
# NAVIGATION: force 3-button nav. Launcher3QuickStep (the gesture/Recents
# provider) is removed from MikeOS, so gestural navigation has NO handler —
# users get trapped in full-screen apps (no swipe-home/Recents). The Google
# vendor blobs default to the gestural overlay, so enforce 3-button on every
# boot (idempotent; retried in background until system services are up).
# ---------------------------------------------------------------------------
(
  n=0
  until [ $n -ge 30 ]; do
    if cmd overlay enable-exclusive --category com.android.internal.systemui.navbar.threebutton >/dev/null 2>&1; then
      settings put secure navigation_mode 0 >/dev/null 2>&1 || true
      log "navigation: 3-button enforced"
      break
    fi
    n=$((n+1)); sleep 5
  done
) &

# ---------------------------------------------------------------------------
# 0. FIRST-BOOT EXTRACTION of the baked runtime payload (idempotent).
# ---------------------------------------------------------------------------
if [ ! -x "$MIKEOS_RUNTIME/bin/node" ] || [ ! -f "$MIKEOS_RUNTIME/.extracted" ]; then
    if [ -f "$MIKEOS_PAYLOAD" ]; then
        log "first boot: extracting baked runtime $MIKEOS_PAYLOAD -> $MIKEOS_RUNTIME"
        mkdir -p "$MIKEOS_RUNTIME"
        if tar -xzf "$MIKEOS_PAYLOAD" -C "$MIKEOS_RUNTIME" 2>/dev/null; then
            chmod -R a+rX "$MIKEOS_RUNTIME" 2>/dev/null || true
            touch "$MIKEOS_RUNTIME/.extracted"
            log "runtime extracted OK"
        else
            log "FATAL: runtime extraction failed"; exit 1
        fi
    else
        log "FATAL: baked runtime payload not found at $MIKEOS_PAYLOAD"; exit 1
    fi
fi

# ---------------------------------------------------------------------------
# 1. Termux-shell shim. The baked Node is a Termux build; its child_process
#    default shell is /data/data/com.termux/files/usr/bin/sh (absent here).
# ---------------------------------------------------------------------------
mkdir -p /data/data/com.termux/files/usr/bin 2>/dev/null || true
ln -sf /system/bin/sh /data/data/com.termux/files/usr/bin/sh 2>/dev/null || true

# ---------------------------------------------------------------------------
# 2. Data dirs (absolute + writable). SQLite db dir + daemon HOME + tmp + redis.
# ---------------------------------------------------------------------------
mkdir -p "$MIKEOS_DATA/db" "$REDISDIR" "$HOME" "$TMPDIR" 2>/dev/null || true
chmod 0771 "$MIKEOS_DATA" 2>/dev/null || true

# ---------------------------------------------------------------------------
# 3. Redis — ephemeral cache/bus (durable data is in SQLite). Absolute dir,
#    never block writes on a bgsave failure. Runs as the (root) service user.
# ---------------------------------------------------------------------------
redis-cli -p 6379 ping >/dev/null 2>&1 || \
  redis-server --daemonize yes --port 6379 \
    --dir "$REDISDIR" \
    --stop-writes-on-bgsave-error no >/dev/null 2>&1 || \
    log "WARN: redis start returned non-zero (continuing)"

sleep 1

# ---------------------------------------------------------------------------
# 4. exec the daemon in the FOREGROUND so init supervises node directly and
#    restarts it on crash.
# ---------------------------------------------------------------------------
cd "$MIKEOS_DAEMON_DIR" 2>/dev/null || { log "FATAL: daemon dir $MIKEOS_DAEMON_DIR not found"; exit 1; }
log "starting node dist/index.js (SQLITE_DB_PATH=$SQLITE_DB_PATH IPC=$IPC_SOCKET_PATH)"
exec node "$MIKEOS_DAEMON_DIR/dist/index.js"
