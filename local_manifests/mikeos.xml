<?xml version="1.0" encoding="UTF-8"?>
<!--
    MikeOS ROM — repo local manifest.

    Place this file at .repo/local_manifests/mikeos.xml in your LineageOS 23.2
    source checkout (see README build runbook), then `repo sync vendor/google/tegu`.

    What it does: adds the proprietary Google vendor blobs for tegu (Pixel 9a).
    These are the closed-source hardware bits (graphics, camera HAL, modem, the
    Tensor platform blobs, etc.) the device needs to boot — they are firmware,
    NOT Google apps, and do not make the ROM "Googled".

    VERIFIED 2026-07-26 on the live build (LineageOS 23.2, tegu):
      * The blobs live in a PER-DEVICE muppets repo, not the monolithic one:
          name : TheMuppets/proprietary_vendor_google_tegu   (has lineage-23.2)
          path : vendor/google/tegu   (bundles the zumapro platform blobs too —
                 the device trees only reference vendor/google/tegu)
      * `breakfast tegu` does NOT auto-add this — you must sync it explicitly, or
        lineage_tegu.mk's `inherit-product vendor/google/tegu/tegu-vendor.mk` is
        missing and product config fails with "Don't have a product spec".
      * The monolithic TheMuppets/proprietary_vendor_google has NO lineage-23.2
        branch (it aborts the whole sync) — do not use it for tegu.

    vendor/mikeos is deliberately NOT a project here — this repo (mikeos-rom) is
    cloned/symlinked into the tree at vendor/mikeos by build-tegu.sh, so `repo
    sync` never touches or clobbers it.
-->
<manifest>

  <!-- Proprietary Google hardware blobs for tegu (Pixel 9a) — per-device muppets repo. -->
  <project
      name="TheMuppets/proprietary_vendor_google_tegu"
      path="vendor/google/tegu"
      remote="github"
      revision="lineage-23.2" />

</manifest>
